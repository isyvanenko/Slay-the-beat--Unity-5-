# Doxygen configuration for Slay (The beat).

PROJECT_NAME           = "Slay (The beat)"
PROJECT_BRIEF          = "Unity rhythm game scripts"
OUTPUT_DIRECTORY       = docs/generated

INPUT                  = "Slay (The beat)/Assets/Project/Scripts" \
                         docs/README.md \
                         docs/index.md \
                         docs/mainpage.dox \
                         docs/groups.dox
RECURSIVE              = YES
FILE_PATTERNS          = *.cs
EXCLUDE_PATTERNS       = */Library/* \
                         */Temp/* \
                         */Logs/* \
                         */Obj/* \
                         */Build/* \
                         */Builds/*

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_EXTRA_STYLESHEET  = docs/custom.css
GENERATE_LATEX         = NO
GENERATE_XML           = NO

MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = docs/index.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO

OPTIMIZE_OUTPUT_JAVA   = YES

HAVE_DOT               = YES
UML_LOOK               = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_GRAPH            = YES
DIRECTORY_GRAPH        = YES
